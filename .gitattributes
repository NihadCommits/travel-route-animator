# Store and check out text files with LF on every OS.
# Without this, core.autocrlf=true on Windows produces CRLF files that Prettier flags.
* text=auto eol=lf

# Windows batch files need CRLF to run correctly
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary assets: never touch line endings or try to diff
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.mp4 binary
*.mov binary
*.glb binary
*.woff binary
*.woff2 binary
*.ttf binary
