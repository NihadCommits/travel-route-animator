{
  "name": "travel-route-animator",
  "version": "0.0.0",
  "private": true,
  "description": "Animated travel route maps for vlogs, previewed and rendered with Remotion and MapLibre",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "typecheck": "tsc -p tsconfig.json && pnpm -r --no-bail typecheck",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "data:airports": "pnpm --filter @travel-route-animator/server data:airports",
    "studio": "pnpm --filter @travel-route-animator/scene studio",
    "render:etappe": "pnpm --filter @travel-route-animator/scene render:etappe"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
