# Copy to .env and fill in. Never commit .env.

# Server (must stay on a loopback address)
PORT=5174
HOST=127.0.0.1
DATA_DIR=./data
OUTPUT_DIR=./output

# Routing: openrouteservice, free standard key
# https://openrouteservice.org/plans/
ORS_API_KEY=

# Optional: satellite imagery (MapTiler). The free plan is for non-commercial use only; mind the quota.
MAPTILER_API_KEY=

# Contact for the User-Agent sent to free services (Photon, OSRM), as their fair-use policies ask.
# A profile or project URL works and keeps your e-mail address out of it.
SERVICE_CONTACT=

# Place search (Photon). The public instance asks for fair use; a self-hosted one works too.
PHOTON_URL=https://photon.komoot.io
