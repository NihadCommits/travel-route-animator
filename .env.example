# Copy to .env and fill in. Never commit .env.

# Server (must stay on a loopback address)
PORT=5174
HOST=127.0.0.1
DATA_DIR=./data
OUTPUT_DIR=./output

# Rendering: Chromium's OpenGL backend for the maps. angle uses the GPU; if renders fail or come
# out black, try angle-egl, egl, vulkan, or the slow software renderers swangle / swiftshader.
RENDER_GL=angle
# Bundle the scene right after the server starts, so the first render need not wait for it.
RENDER_PREPARE_ON_START=true

# Routing: openrouteservice, free standard key (sign up at https://openrouteservice.org/dev/).
# Road, cycling and walking routes need it; the key stays on the server and is never logged.
ORS_API_KEY=
# Optional: a self-hosted openrouteservice instead of the public API.
ORS_URL=https://api.openrouteservice.org
# OSRM on the FOSSGIS routing server, offered as a way out when openrouteservice is down.
# Its usage policy: at most one request per second, a User-Agent (SERVICE_CONTACT), attribution.
OSRM_URL=https://routing.openstreetmap.de

# Optional: satellite imagery (MapTiler). The free plan is for non-commercial use only; mind the quota.
MAPTILER_API_KEY=

# Contact for the User-Agent sent to free services (Photon, OSRM), as their fair-use policies ask.
# A profile or project URL works and keeps your e-mail address out of it.
SERVICE_CONTACT=

# Place search (Photon). The public instance asks for fair use; a self-hosted one works too.
PHOTON_URL=https://photon.komoot.io
